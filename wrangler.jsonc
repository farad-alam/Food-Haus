{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-haus",
  "main": "cloudflare/worker.ts", // wraps .open-next/worker.js and adds the cron handler
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Non-secret config only. Secrets (Stripe keys, DB URL, email key) are set
  // with `wrangler secret put` / the dashboard — never committed (R13.6).
  "vars": {
    "APP_ENV": "preview"
  },
  // Cache bindings for on-demand revalidation (open-next.config.ts).
  // The ids below are placeholders for LOCAL dev only; create the real ones with
  //   wrangler kv namespace create NEXT_INC_CACHE_KV
  //   wrangler d1 create food-haus-tag-cache
  // and paste the returned ids here before the first deploy.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "local-placeholder-replace-before-deploy" }
  ],
  // Menu photos (R9.7). Create the bucket first:  wrangler r2 bucket create food-haus-photos
  // The binding is the credential: no access keys are stored anywhere. See docs/security-checklist.md,
  // "Photo upload", for what to verify after the first deploy (not testable without a real bucket).
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "food-haus-photos" }
  ],
  // Resizes uploads to 4:3 WebP (R10.5) inside the Worker. Needs the Cloudflare Images binding enabled on the account.
  "images": { "binding": "IMAGES" },
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "food-haus-tag-cache", "database_id": "local-placeholder-replace-before-deploy" }
  ],
  "env": {
    "production": {
      "name": "food-haus-production",
      "vars": { "APP_ENV": "production" }
    }
  },
  // Cron Triggers (UTC). Every 5 minutes: cancel unpaid card orders older than 45 min and prune
  // old counters, sessions and tokens (lib/maintenance.ts). Needs the CRON_SECRET secret:
  //   openssl rand -base64 32 | wrangler secret put CRON_SECRET
  "triggers": { "crons": ["*/5 * * * *"] }
  // TODO: the daily sales report adds a second cron (requirements R9.12).
}
