# Copy to .env.local for local development. NEVER commit real values (R13.6).
# In Cloudflare: non-secret vars live in wrangler.jsonc, secrets via `wrangler secret put`.

# local | preview | production — only production is indexable (R11.13)
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (London), pooled connection string. Accessed over HTTPS via
# @neondatabase/serverless, so no TCP/Hyperdrive is needed.
DATABASE_URL=

# AES-256-GCM key for TOTP seeds at rest: `openssl rand -base64 32`. Losing it
# locks every owner/manager out of 2FA; keep a copy in the password manager.
SECRET_BOX_KEY=

# Stripe — TEST keys in local/preview, LIVE keys only in production (R8.8)
STRIPE_SECRET_KEY=            # restricted key, limited to what the site needs
STRIPE_WEBHOOK_SECRET=

# Transactional email via Resend (SPF/DKIM on the shop's domain)
EMAIL_API_KEY=
EMAIL_FROM=                   # an address on the shop's own domain, not Gmail, e.g. "Food Haus <orders@yourdomain>"
EMAIL_API_URL=                # leave empty (Resend). Only for staging/tests with a Resend-compatible endpoint
ORDER_NOTIFY_EMAIL=           # shop inbox for the new-order backup alert (R13.10); optional

# Cloudflare Turnstile (R13.13)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Places UI Kit (R7) — restrict by website address AND API (R7.5)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Google Analytics 4 — loads only after cookie consent (R11.9)
NEXT_PUBLIC_GA_ID=

# Sanity (blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret the Cloudflare Cron Trigger sends to /api/cron/maintenance (16+ characters).
# Without it the endpoint refuses everything: `openssl rand -base64 32`
CRON_SECRET=
