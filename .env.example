# Copy to .env.local for local development. NEVER commit real values (R13.6).
# In Cloudflare: non-secret vars live in wrangler.jsonc, secrets via `wrangler secret put`.

# local | preview | production — only production is indexable (R11.13)
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (London/EU region), reached through Hyperdrive in Workers
DATABASE_URL=

# Stripe — TEST keys in local/preview, LIVE keys only in production (R8.8)
STRIPE_SECRET_KEY=            # restricted key, limited to what the site needs
STRIPE_WEBHOOK_SECRET=

# Transactional email (SPF/DKIM on the shop's domain)
EMAIL_API_KEY=
EMAIL_FROM=                   # an address on the shop's own domain, not Gmail

# Cloudflare Turnstile (R13.13)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Places UI Kit (R7) — restrict by website address AND API (R7.5)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Google Analytics 4 — loads only after cookie consent (R11.9)
NEXT_PUBLIC_GA_ID=

# Sanity (blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
